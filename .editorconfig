root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

# BOM keeps Windows PowerShell 5.1 from misreading non-ASCII characters
[*.{ps1,psm1,psd1,cs}]
charset = utf-8-bom

[*.{yml,yaml}]
indent_size = 2
end_of_line = lf

[*.md]
end_of_line = lf
trim_trailing_whitespace = false
